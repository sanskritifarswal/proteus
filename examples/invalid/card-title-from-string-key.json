{
  "grammar": "newsfeed@0.2.0",
  "tree": {
    "type": "Screen",
    "props": {
      "density": "comfortable"
    },
    "slots": {
      "sections": [
        {
          "type": "Section",
          "props": {
            "source": "forYou"
          },
          "slots": {
            "content": {
              "type": "Collection",
              "props": {
                "layout": "stack",
                "limit": "5"
              },
              "slots": {
                "item": {
                  "type": "Card",
                  "props": {
                    "variant": "compact"
                  },
                  "slots": {
                    "title": {
                      "type": "Text",
                      "props": {
                        "role": "title",
                        "maxLines": "2"
                      },
                      "key": "section.forYou"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
