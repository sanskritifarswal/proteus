{
  "name": "proteus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generative UI framework: typed component grammars, model-assembled layouts.",
  "scripts": {
    "schema": "node src/build-schema.ts && node src/export-grammar.ts",
    "check": "tsc --noEmit && node src/validate.ts && node src/check-sampler.ts && node src/check-sim.ts && node src/check-policy.ts",
    "count": "node src/count-space.ts",
    "sample": "node src/sample-cli.ts",
    "gallery": "node src/gallery.ts",
    "simulate": "node src/sim/run.ts",
    "typecheck": "tsc --noEmit",
    "train": "node src/policy/run.ts",
    "twins": "node src/policy/experiment-twins.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3"
  }
}
